
CREATE DATABASE QUAN_LY_SV;
GO
USE QUAN_LY_SV;
GO
CREATE TABLE LOPHOCPHAN(
	TEN_LOP VARCHAR(10) PRIMARY KEY,
	SO_SV INT,
	MA_GV INT UNIQUE,
);

CREATE TABLE SINHVIEN (
	MSSV BIGINT PRIMARY KEY,
	TEN_LOP VARCHAR(10) REFERENCES LOPHOCPHAN(TEN_LOP),
	MA_MON VARCHAR(10),
	);

CREATE TABLE DIEM (
	MSSV BIGINT REFERENCES SINHVIEN(MSSV),
	DIEM INT PRIMARY KEY,
	MA_MON VARCHAR(10),
	);

ALTER TABLE SINHVIEN
ADD EMAIL VARCHAR(30);

ALTER TABLE SINHVIEN
DROP COLUMN EMAIL;

ALTER TABLE SINHVIEN
ADD MA_GV INT; 

EXEC sp_rename 'DIEM.DIEM', 'GRADE', 'COLUMN';

ALTER TABLE SINHVIEN
ADD CONSTRAINT FK_SINHVIEN_GV FOREIGN KEY (MA_GV)
REFERENCES LOPHOCPHAN(MA_GV) ON UPDATE CASCADE ON DELETE CASCADE;

SELECT F.NAME AS FOREIGN_KEY_NAME
FROM SYS.foreign_keys F
WHERE F.parent_object_id = OBJECT_ID('SINHVIEN');

ALTER TABLE SINHVIEN
DROP CONSTRAINT FK_SINHVIEN_GV;

SELECT F.NAME AS FOREIGN_KEY_NAME
FROM SYS.foreign_keys F
WHERE F.parent_object_id = OBJECT_ID('SINHVIEN');

